# Django
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=*
DATABASE_URL=postgres://user:password@host:5432/dbname
# Or use separate PG vars (if DATABASE_URL not set)
POSTGRES_DB=rewear
POSTGRES_USER=rewear
POSTGRES_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=5432

# Security / CORS - comma separated
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.onrender.com,https://your-backend.onrender.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Superuser creation
SUPERUSER_SECRET_KEY=change-me-super-secret

# Cloudinary (optional - leave empty to use local media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port (Render sets automatically)
PORT=8000
